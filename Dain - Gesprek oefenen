let deelnemerNaam = '';
let context = {};           // vraag-sleutel -> antwoord
let messages = [];          // { role, content, hidden?, ts }
let isSending = false;

const chatWrap = document.getElementById('chatWrap');
const messagesInner = document.getElementById('messagesInner');
