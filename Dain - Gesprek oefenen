function dbHeaders(extra) {
  return Object.assign({
    'apikey': SUPABASE_ANON_KEY,
    'Authorization': 'Bearer ' + SUPABASE_ANON_KEY,
    'x-sessie-token': sessie ? sessie.token : ''
  }, extra || {});
}

/* =========================================================
   SESSIE: uit de URL (?st=), uit de Labboek-inlog, of zelf inloggen
   ========================================================= */
function leesSessie() {
  const st = new URLSearchParams(window.location.search).get('st');
  if (st) return { token: st, deelnemer_id: null };
  try {
    const o = JSON.parse(localStorage.getItem(LS_SESSIE) || 'null');
    if (o && o.token) return o;
  } catch (e) {}
  return null;
}

function toonLogin(melding) {
  inputBar.classList.add('uit');
  messagesInner.innerHTML = '';
  const kaart = document.createElement('div');
  kaart.className = 'login-card';
  kaart.innerHTML =
    '<h3>Log in met je Labboek</h3>' +
    '<p>' + escapeHtml(melding || 'Dan weet Dain voor welke functie je oefent en welke vragen jij het spannendst vindt.') + '</p>' +
    '<label for="lgNaam">Jouw naam</label><input type="text" id="lgNaam" autocomplete="name" placeholder="Voor- en achternaam">' +
    '<label for="lgCode">Toegangscode</label><input type="text" id="lgCode" autocomplete="off" placeholder="Je code">' +
    '<label class="login-consent"><input type="checkbox" id="lgOk"> Ik ga akkoord met de verwerking van mijn Labboek-gegevens door Unleash Potential Lab. Mijn gegevens worden veilig opgeslagen en niet met derden gedeeld.</label>' +
    '<div class="login-err" id="lgErr"></div>' +
    '<button type="button" class="login-btn" id="lgBtn">Inloggen</button>';
  messagesInner.appendChild(kaart);

  document.getElementById('lgBtn').addEventListener('click', async function () {
    const naam = document.getElementById('lgNaam').value.trim();
    const code = document.getElementById('lgCode').value.trim();
    const ok = document.getElementById('lgOk').checked;
    const err = document.getElementById('lgErr');
    err.textContent = '';
    if (!naam || !code) { err.textContent = 'Vul je naam én je toegangscode in.'; return; }
    if (!ok) { err.textContent = 'Vink aan dat je akkoord gaat met de verwerking van je gegevens.'; return; }
    this.disabled = true; this.textContent = 'Even geduld…';
    try {
      const r = await fetch(SUPABASE_URL + '/rest/v1/rpc/labboek_login', {
        method: 'POST',
        headers: dbHeaders({ 'Content-Type': 'application/json' }),
        body: JSON.stringify({ p_code: code, p_naam: naam, p_toestemming: true })
      });
      const j = await r.json();
      const row = Array.isArray(j) ? j[0] : j;
      if (!r.ok || !row || !row.sessie_token) throw new Error('code');
      sessie = { token: row.sessie_token, deelnemer_id: row.deelnemer_id, naam: row.naam || naam, voornaam: row.voornaam || '' };
      try { localStorage.setItem(LS_SESSIE, JSON.stringify(sessie)); } catch (e) {}
      start();
    } catch (e) {
      this.disabled = false; this.textContent = 'Inloggen';
      err.textContent = e.message === 'code' ? 'Deze code lijkt niet te kloppen. Check hem nog even.' : 'Er ging iets mis met de verbinding. Probeer het nog eens.';
    }
  });
}

async function laadDeelnemer() {
  const res = await fetch(SUPABASE_URL + '/rest/v1/labboek_deelnemers?select=id,naam&order=aangemaakt_op.desc&limit=1', { headers: dbHeaders() });
  const rows = await res.json();
  if (!res.ok || !Array.isArray(rows) || !rows[0]) return false;
  sessie.deelnemer_id = rows[0].id;
  deelnemerNaam = ((rows[0].naam || '').trim().split(/\s+/)[0]) || '';
  return true;
}

async function laadContext() {
  const ids = Object.values(V).join(',');
  const res = await fetch(SUPABASE_URL + '/rest/v1/labboek_antwoorden?select=vraag_id,antwoord&deelnemer_id=eq.' + sessie.deelnemer_id + '&vraag_id=in.(' + ids + ')', { headers: dbHeaders() });
  const rows = await res.json();
  context = {};
  if (Array.isArray(rows)) {
    for (const k in V) {
      const r = rows.find(x => x.vraag_id === V[k]);
      if (r && r.antwoord && r.antwoord.trim()) context[k] = r.antwoord.trim().slice(0, 1500);
    }
  }
}

function functieNaam() { return context.rol || context.eindpunt || ''; }

/* =========================================================
   SYSTEM PROMPT
   ========================================================= */
function bouwSystemPrompt() {
  const blok = (label, waarde) => waarde ? '### ' + label + '\n' + waarde + '\n\n' : '';
  const functie = functieNaam();
  return `Je bent Dain, de AI-sparringpartner van het Alchemist Programma van Uplab Career. In deze chat oefen je met de deelnemer${deelnemerNaam ? ' (' + deelnemerNaam + ')' : ''} een sollicitatiegesprek.

## De functie waarvoor geoefend wordt
${functie ? functie : '(nog onbekend: vraag de deelnemer eerst in één zin voor welke functie hij of zij wil oefenen, en begin daarna pas met het gesprek)'}

## De drie vragen waar de deelnemer het meest tegen opziet (uit het Labboek)
${context.killer ? context.killer : '(niet ingevuld: kies dan zelf drie lastige vragen die passen bij de functie en het profiel)'}

## Achtergrond van de deelnemer (gebruik dit om scherpe, realistische vragen te stellen)
${blok('Kerntalenten', context.talenten)}${blok('Kernwaarden', context.waarden)}${blok('Missie', context.missie)}${blok('Wat de deelnemer al in huis heeft', context.inHuis)}${blok('Wat er nog ontbreekt', context.ontbreekt)}${blok('Wat vacatures vragen', context.vacatures)}${blok('Position statement', context.position)}${blok('Elevator pitch', context.pitch)}
## Verloop van het gesprek
1. Je opent kort en vriendelijk als interviewer: stel jezelf voor als degene die het gesprek voert voor deze functie, en stel dan als eerste vraag: "Vertel eens wat over jezelf."
2. Daarna stel je één voor één veelgestelde sollicitatievragen die passen bij deze functie, zoals: waarom deze functie, wat breng je mee, een situatievraag (vertel over een keer dat…), hoe ga je om met tegenslag of kritiek, waar liggen je ontwikkelpunten, waarom zouden we jou kiezen.
3. De drie vragen waar de deelnemer tegen opziet stel je ALTIJD, verspreid door het gesprek. Formuleer ze zoals een echte interviewer dat zou doen.
4. Stel in totaal zo'n zeven tot negen vragen. Stel steeds maar één vraag tegelijk.
5. Blijf tijdens het gesprek in je rol als interviewer: reageer kort en natuurlijk op een antwoord (een knik, een doorvraag als het antwoord vaag of algemeen is), maar geef nog géén feedback of tips. Vraag gerust één keer door als iemand om de vraag heen draait — dat doet een echte interviewer ook.
6. Loopt het gesprek ten einde (na je laatste vraag), sluit het dan af zoals een interviewer dat doet en vraag daarna, uit je rol: "Wil je feedback op het gesprek?"
7. Wil de deelnemer feedback, geef die dan als Dain, de coach. Per onderwerp: wat ging goed, wat kan sterker en hoe. Besteed extra aandacht aan de drie spannende vragen. Wees eerlijk en concreet, verwijs naar wat de deelnemer letterlijk zei, en eindig bemoedigend. Gebruik daarbij ###-koppen per onderdeel en "- " voor opsommingen.
8. Wil de deelnemer halverwege stoppen of meteen feedback, volg dan de deelnemer.

## Stijl
- Nederlands, je/jij-vorm, warm maar professioneel. Als interviewer realistisch: niet overdreven vriendelijk, niet streng.
- Korte berichten tijdens het interview (een reactie van één of twee zinnen plus de volgende vraag).
- Geen reismetaforen. Blijf bij het sollicitatiegesprek; wijkt de deelnemer af, breng het vriendelijk terug.`;
}

/* =========================================================
   RENDERING
   ========================================================= */
function nowTime() { const d = new Date(); return String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0'); }
function escapeHtml(str) { const div = document.createElement('div'); div.textContent = str; return div.innerHTML; }

function formatText(text) {
  let safe = escapeHtml(text);
  safe = safe.replace(/^###\s+(.+)$/gm, '<h4>$1</h4>');
  safe = safe.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
  const lines = safe.split('\n'); const out = []; let inList = false;
  for (const l of lines) {
    const m = l.match(/^-\s+(.+)$/);
    if (m) { if (!inList) { out.push('<ul class="msg-list">'); inList = true; } out.push('<li>' + m[1] + '</li>'); }
    else { if (inList) { out.push('</ul>'); inList = false; } out.push(l); }
  }
  if (inList) out.push('</ul>');
  return out.join('\n');
}

function isChatNearBottom() { return chatWrap.scrollTop + chatWrap.clientHeight >= chatWrap.scrollHeight - 80; }

function renderMessage(m) {
  if (m.hidden) return null;
  const row = document.createElement('div');
  row.className = 'msg-row ' + (m.role === 'user' ? 'user' : 'dain');
  if (m.role !== 'user') { const av = document.createElement('div'); av.className = 'msg-avatar'; row.appendChild(av); }
  const col = document.createElement('div'); col.className = 'msg-bubble-col';
  const bubble = document.createElement('div'); bubble.className = 'msg-bubble';
  bubble.innerHTML = formatText(m.content || '');
  col.appendChild(bubble);
  const time = document.createElement('div'); time.className = 'msg-time'; time.textContent = m.ts || '';
  col.appendChild(time);
  row.appendChild(col);
  messagesInner.appendChild(row);
  chatWrap.scrollTop = chatWrap.scrollHeight;
  return bubble;
}

function showTyping() {
  const row = document.createElement('div');
  row.className = 'msg-row dain'; row.id = 'typingRow';
  row.innerHTML = '<div class="msg-avatar"></div><div class="msg-bubble-col"><div class="msg-bubble"><div class="typing-dots"><span></span><span></span><span></span></div></div></div>';
  messagesInner.appendChild(row);
