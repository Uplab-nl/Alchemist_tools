<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Dain · Sollicitatiegesprek oefenen · Uplab</title>
<link href="https://fonts.googleapis.com/css2?family=Doppio+One&family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
<style>
  :root {
    --brand-primary: #292727;
    --accent1: #549E39;
    --accent2: #3E6913;
    --white: #FFFFFF;
    --light-bg: #f5f5f5;
    --chat-bg: #f0f1ec;
    --card-bg: #fafafa;
    --border-light: #e0e0e0;
    --avatar-img: url('data:image/jpeg;base64,');
    --text-muted: #666;
  }

  .dain-widget, .dain-widget * { box-sizing: border-box; margin: 0; padding: 0; }
  .dain-widget button { position: static !important; inset: auto !important; float: none !important; }

  .dain-widget {
    font-family: 'Roboto', sans-serif;
    background: var(--white);
    color: var(--brand-primary);
  }

  .app {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: var(--app-height, 100dvh);
    background: var(--white);
    overflow: hidden;
  }

  @media (min-width: 860px) {
    .app {
      height: min(var(--app-height, 100dvh), 720px);
      max-width: 720px;
      margin: 0 auto;
      border-radius: 14px;
      box-shadow: 0 4px 24px rgba(0,0,0,0.12);
    }
  }

  /* ─── STICKY HEADER ─── */
  .sticky-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--brand-primary);
    padding: 12px 52px 12px 16px;
    display: flex !important;
    flex-direction: row !important;
    align-items: center;
    justify-content: space-between;
    box-shadow: 0 2px 12px rgba(0,0,0,0.3);
    flex-shrink: 0;
  }

  .header-left { display: flex; align-items: center; gap: 12px; }

  .avatar-d {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    flex-shrink: 0;
    background-image: var(--avatar-img);
    background-size: cover;
    background-position: center;
  }

  .header-title {
    font-family: 'Doppio One', sans-serif;
    color: var(--accent1);
    font-size: 16px;
    line-height: 1.25;
  }

  .header-title-row {
    display: flex !important;
    flex-direction: row !important;
    align-items: center;
    gap: 6px;
    color: var(--accent1);
  }

  .ai-badge {
    display: inline-block !important;
    width: auto !important;
    background: var(--accent1);
    color: #292727 !important;
    font-family: 'Roboto', sans-serif;
    font-size: 9px;
    font-weight: 700;
    padding: 1px 4px;
    border-radius: 3px;
    letter-spacing: 0.3px;
    line-height: 1.5;
    flex-shrink: 0;
  }

  .header-sub {
    font-family: 'Roboto', sans-serif;
    font-size: 11.2px;
    color: #c9c9c9 !important;
    font-weight: 400;
    display: block;
  }

  .header-actions {
    display: flex !important;
    flex-direction: row !important;
    gap: 8px;
    flex-shrink: 0 !important;
    align-items: center;
    width: auto !important;
  }

  .btn-icon {
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.25);
    color: white;
    border-radius: 8px;
    padding: 7px 12px;
    cursor: pointer;
    font-family: 'Roboto', sans-serif;
    font-size: 12.8px;
    transition: all 0.2s;
    white-space: nowrap;
    display: inline-block !important;
    width: auto !important;
    max-width: none !important;
    flex: none !important;
    flex-shrink: 0 !important;
  }
  .btn-icon:hover { background: rgba(255,255,255,0.22); }

  /* ─── DIAGONAL BANNER ─── */
  .header-banner {
    background: var(--brand-primary);
    position: relative;
    overflow: hidden;
    padding: 22px 20px 38px;
    flex-shrink: 0;
  }

  .header-banner::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    height: 30px;
    background: var(--chat-bg);
    clip-path: polygon(0 100%, 100% 0, 100% 100%);
  }

  .header-banner::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; height: 100%;
    background: linear-gradient(135deg, #3a3838 0%, transparent 55%);
    opacity: 0.5;
  }

  .header-banner-content { position: relative; z-index: 2; }

  .header-banner h1 {
    font-family: 'Doppio One', sans-serif;
    color: var(--white);
    font-size: clamp(18.4px, 4vw, 24px);
    line-height: 1.3;
    margin-bottom: 4px;
  }
  .header-banner h1 span { color: var(--accent1); }
  .header-banner p { color: #d9d9d9; font-size: 13.6px; max-width: 480px; }

  /* ─── CHAT AREA ─── */
  .privacy-note {
    background: var(--chat-bg);
    color: var(--text-muted);
    font-size: 11.52px;
    text-align: center;
    padding: 6px 16px 0;
    line-height: 1.4;
    flex-shrink: 0;
  }

  .chat-wrap {
    flex: 1;
    overflow-y: auto;
    background: var(--chat-bg);
  }

  .messages-inner {
    padding: 18px 14px 10px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .msg-row { display: flex; gap: 8px; max-width: 100%; animation: fadeIn 0.25s ease; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

  .msg-row.user { justify-content: flex-end; }

  .msg-avatar {
    width: 30px; height: 30px; border-radius: 50%;
    background-image: var(--avatar-img);
    background-size: cover;
    background-position: center;
    flex-shrink: 0; margin-top: 2px;
  }

  .msg-bubble-col { display: flex; flex-direction: column; max-width: 78%; }
  .msg-row.user .msg-bubble-col { align-items: flex-end; }

  .msg-bubble {
    padding: 9px 13px;
    border-radius: 14px;
    font-size: 14.72px;
    line-height: 1.5;
    white-space: pre-wrap;
    word-wrap: break-word;
    box-shadow: 0 1px 1px rgba(0,0,0,0.06);
  }

  .msg-row.dain .msg-bubble {
    background: var(--white);
    color: var(--brand-primary);
    border-radius: 4px 14px 14px 14px;
    border: 1px solid var(--border-light);
  }

  .msg-row.user .msg-bubble {
    background: var(--accent1);
    color: white;
    border-radius: 14px 4px 14px 14px;
  }

  .msg-bubble strong { font-weight: 700; }
  .msg-bubble .msg-list { margin: 6px 0; padding-left: 20px; }
  .msg-bubble .msg-list li { margin-bottom: 5px; line-height: 1.45; }
  .msg-bubble .msg-list li:last-child { margin-bottom: 0; }

  .msg-bubble h4 {
    font-family: 'Doppio One', sans-serif;
    font-weight: 400;
    font-size: 17px;
    line-height: 1.35;
    color: var(--brand-primary);
    margin: 16px 0 8px;
  }
  .msg-bubble h4:first-child { margin-top: 2px; }
  .msg-bubble h4::after {
    content: '';
    display: block;
    width: 34px;
    height: 3px;
    background: var(--accent1);
    border-radius: 2px;
    margin-top: 6px;
  }
  .msg-row.user .msg-bubble h4 { color: white; }
  .msg-row.user .msg-bubble h4::after { background: white; opacity: 0.6; }

  .msg-time {
    font-size: 10.88px;
    color: var(--text-muted);
    margin-top: 2px;
    padding: 0 4px;
  }

  .feedback-buttons {
    display: flex;
    gap: 4px;
    margin-top: 2px;
    padding: 0 4px;
  }
  .btn-schrijf-verder {
    align-self: flex-start;
    margin-top: 8px;
    background: white; border: 2px solid var(--accent1); color: var(--accent1);
    border-radius: 10px; padding: 9px 14px; font-family: 'Roboto', sans-serif;
    font-size: 13.2px; font-weight: 500; cursor: pointer; transition: all 0.15s;
  }
  .btn-schrijf-verder:hover { background: var(--accent1); color: white; }
  .fb-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 15.2px;
    padding: 2px 5px;
    border-radius: 6px;
    opacity: 0.45;
    transition: opacity 0.15s, background 0.15s, transform 0.1s;
    line-height: 1;
  }
  .fb-btn:hover { opacity: 0.85; background: var(--light-bg); }
  .fb-btn.active { opacity: 1; background: var(--light-bg); transform: scale(1.1); }
  .fb-btn.fb-up.active { background: rgba(84,158,57,0.18); }
  .fb-btn.fb-down.active { background: rgba(192,57,43,0.15); }

  .file-chip {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(255,255,255,0.18);
    border-radius: 10px;
    padding: 8px 10px;
    font-size: 13.6px;
  }
  .msg-row.dain .file-chip { background: var(--light-bg); }
  .file-chip .file-icon { font-size: 19.2px; }

  /* Typing indicator */
  .typing-dots { display: flex; gap: 4px; padding: 4px 2px; }
  .typing-dots span {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--text-muted);
    animation: blink 1.2s infinite;
  }
  .typing-dots span:nth-child(2) { animation-delay: 0.2s; }
  .typing-dots span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes blink { 0%, 80%, 100% { opacity: 0.25; } 40% { opacity: 1; } }

  /* ─── INPUT BAR ─── */
  .input-bar {
    flex-shrink: 0;
    background: var(--white);
    border-top: 1px solid var(--border-light);
    padding: 10px 12px;
    display: flex;
    align-items: flex-end;
    gap: 8px;
  }

  .input-bar textarea {
    flex: 1;
    resize: none;
    border: 1px solid var(--border-light);
    border-radius: 18px;
    padding: 10px 16px;
    font-family: 'Roboto', sans-serif;
    font-size: 14.72px;
    line-height: 1.4;
    max-height: 110px;
    outline: none;
    transition: border-color 0.2s;
  }
  .input-bar textarea:focus { border-color: var(--accent1); }

  .round-btn {
    width: 42px; height: 42px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    font-size: 18.4px;
    flex-shrink: 0;
    transition: background 0.2s;
  }
  .round-btn.send { background: var(--accent1); color: white; }
  .round-btn.send:hover { background: var(--accent2); }
  .round-btn.send:disabled { background: #b8d8ac; cursor: not-allowed; }
  .round-btn.attach { background: var(--light-bg); color: var(--brand-primary); border: 1px solid var(--border-light); }
  .round-btn.attach:hover { background: var(--border-light); }

  .labboek-status {
    font-size: 11.52px;
    color: var(--accent2);
    text-align: center;
    padding: 4px 12px 0;
    background: var(--white);
  }

  .labboek-cta-btn {
    background: var(--accent1);
    color: white;
    border: none;
    border-radius: 20px;
    font-family: 'Doppio One', sans-serif;
    font-size: 12.8px;
    padding: 8px 18px;
    cursor: pointer;
    transition: background 0.2s;
  }
  .labboek-cta-btn:hover { background: var(--accent2); }
  .labboek-cta-wrap { padding: 6px 12px 2px; text-align: center; }

  .quick-reply-row { display: flex; justify-content: flex-end; margin: 4px 0 16px; animation: fadeIn 0.25s ease; }
  .quick-reply-card {
    max-width: 78%; background: var(--accent1); color: white;
    border-radius: 14px 4px 14px 14px; padding: 14px 16px;
    display: flex; flex-direction: column; gap: 12px;
  }
  .quick-reply-card p { font-size: 14.4px; line-height: 1.4; color: white; }
  .quick-reply-actions { display: flex; flex-direction: column; gap: 8px; }
  .quick-reply-btn {
    background: white; border: none; color: var(--accent2);
    border-radius: 10px; padding: 11px 14px; font-family: 'Roboto', sans-serif;
    font-size: 13.6px; font-weight: 500; cursor: pointer; text-align: left;
    transition: background 0.15s;
  }
  .quick-reply-btn:hover { background: #eef3ea; }

  /* ─── POPUPS ─── */
  .popup-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.55);
    z-index: 999;
    padding: 20px;
    overflow-y: auto;
    backdrop-filter: blur(2px);
  }
  .popup-overlay.active {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 60px;
  }
  .popup-box {
    background: white;
    border-radius: 14px;
    max-width: 480px;
    width: 100%;
    padding: 28px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.25);
    position: relative;
    animation: slideIn 0.25s ease;
  }
  @keyframes slideIn { from { transform: translateY(-20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
  .popup-box h2 {
    font-family: 'Doppio One', sans-serif;
    font-size: 18.4px;
    margin-bottom: 14px;
    color: var(--brand-primary);
    padding-right: 20px;
  }
  .popup-box p { font-size: 14.4px; line-height: 1.7; color: #444; margin-bottom: 12px; }
  .popup-close {
    position: absolute; top: 14px; right: 14px;
    background: none; border: none; font-size: 20.8px;
    cursor: pointer; color: var(--text-muted); line-height: 1; padding: 4px;
  }
  .popup-close:hover { color: var(--brand-primary); }
  .popup-btn {
    background: var(--accent1); color: white; border: none; border-radius: 8px;
    font-family: 'Doppio One', sans-serif; padding: 11px 24px; cursor: pointer;
    font-size: 14.08px; margin-top: 6px; margin-right: 8px; transition: background 0.2s;
  }
  .popup-btn:hover { background: var(--accent2); }
  .popup-btn-secondary {
    background: transparent; color: var(--brand-primary); border: 2px solid var(--border-light);
    border-radius: 8px; font-family: 'Roboto', sans-serif; padding: 9px 22px; cursor: pointer;
    font-size: 13.76px; margin-top: 6px; transition: all 0.2s;
  }
  .popup-btn-secondary:hover { border-color: var(--brand-primary); }
  .popup-box textarea {
    width: 100%; min-height: 160px; border: 1px solid var(--border-light);
    border-radius: 8px; padding: 10px; font-family: 'Roboto', sans-serif;
    font-size: 14.08px; resize: vertical; margin-bottom: 10px;
  }

  @media (max-width: 480px) {
    .popup-box { padding: 20px; }
    .header-banner h1 { font-size: 16.8px; }
  }

  /* ─── INLOGKAART ─── */
  .login-card {
    background: var(--white); border: 1px solid var(--border-light); border-radius: 14px;
    padding: 20px; margin: 6px 0 12px; max-width: 420px; align-self: center; width: 100%;
  }
  .login-card h3 { font-family: 'Doppio One', sans-serif; font-weight: 400; font-size: 17px; margin-bottom: 6px; }
  .login-card p { font-size: 13.6px; color: #555; line-height: 1.5; margin-bottom: 10px; }
  .login-card label { display: block; font-size: 13px; font-weight: 500; margin: 10px 0 4px; }
  .login-card input[type=text] {
    width: 100%; border: 2px solid var(--border-light); border-radius: 9px; padding: 10px 12px;
    font-family: 'Roboto', sans-serif; font-size: 14px; outline: none;
  }
  .login-card input[type=text]:focus { border-color: var(--accent1); }
  .login-consent { display: flex; gap: 8px; align-items: flex-start; margin-top: 12px; font-size: 12px; color: #555; line-height: 1.5; }
  .login-consent input { margin-top: 2px; accent-color: var(--accent1); }
  .login-err { color: #c0392b; font-size: 12.5px; margin-top: 8px; min-height: 16px; }
  .login-btn {
    width: 100%; margin-top: 10px; background: var(--accent1); color: white; border: none; border-radius: 10px;
    font-family: 'Doppio One', sans-serif; font-size: 14px; padding: 11px; cursor: pointer;
  }
  .login-btn:hover { background: var(--accent2); }
  .login-btn:disabled { opacity: .6; cursor: wait; }
  .input-bar.uit { opacity: .5; pointer-events: none; }
</style>
</head>
