function logSessieId() {
  let id = null;
  try { id = localStorage.getItem('dain_sollicitatie_session_id'); } catch (e) {}
  if (!id) { id = 'sollicitatie_' + Math.random().toString(36).slice(2) + Date.now(); try { localStorage.setItem('dain_sollicitatie_session_id', id); } catch (e) {} }
  return id;
}
async function logToSupabase(role, content) {
  try {
    await fetch(SUPABASE_URL + '/rest/v1/dain_chatlog', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'apikey': SUPABASE_ANON_KEY, 'Authorization': 'Bearer ' + SUPABASE_ANON_KEY, 'Prefer': 'return=minimal' },
      body: JSON.stringify({ session_id: logSessieId(), role, message: content })
    });
  } catch (e) {}
}

/* =========================================================
   SAMENVATTING + OPSLAAN IN HET LABBOEK
   ========================================================= */
const SUMMARY_PROMPT = `Stap nu uit je rol als interviewer. Maak op basis van het hele oefengesprek hierboven een samenvatting voor de deelnemer, in het Nederlands en in de jij-vorm. Gebruik exact dit format:

**Samenvatting van het oefengesprek**
(2-3 zinnen: voor welke functie werd geoefend en hoe verliep het gesprek)

**Wat ging goed**
- (2-4 concrete punten, verwijs naar wat de deelnemer echt zei)

**Belangrijkste aandachtspunten**
- (2-4 concrete punten met een tip hoe het sterker kan; besteed extra aandacht aan de drie vragen waar de deelnemer tegen opzag)

**Volgende stap**
(1-2 zinnen: wat de deelnemer voor een echt gesprek nog kan oefenen of voorbereiden)

Kort, eerlijk en bemoedigend. Start direct met **Samenvatting van het oefengesprek**, zonder inleidende zin.`;

async function opslaanInLabboek(tekst) {
  if (!sessie || !sessie.deelnemer_id) return false;
  try {
    const headers = dbHeaders({ 'Content-Type': 'application/json' });
    const r = await fetch(SUPABASE_URL + '/rest/v1/labboek_antwoorden?select=id&deelnemer_id=eq.' + sessie.deelnemer_id + '&vraag_id=eq.' + SAMENVATTING_VRAAG_ID, { headers });
    const bestaand = await r.json();
    let res;
    if (Array.isArray(bestaand) && bestaand[0]) {
      res = await fetch(SUPABASE_URL + '/rest/v1/labboek_antwoorden?id=eq.' + bestaand[0].id, { method: 'PATCH', headers, body: JSON.stringify({ antwoord: tekst, bijgewerkt_op: new Date().toISOString() }) });
    } else {
      res = await fetch(SUPABASE_URL + '/rest/v1/labboek_antwoorden', { method: 'POST', headers, body: JSON.stringify({ deelnemer_id: sessie.deelnemer_id, vraag_id: SAMENVATTING_VRAAG_ID, antwoord: tekst }) });
    }
    return res.ok;
  } catch (e) { return false; }
}

document.getElementById('btnSummary').addEventListener('click', async () => {
  const echteBerichten = messages.filter(m => !m.hidden && m.role === 'user');
  const sc = document.getElementById('summaryContent');
  openPopup('popupSummary');
  if (!echteBerichten.length) {
    sc.innerHTML = '<p>Er is nog geen oefengesprek om samen te vatten. Start eerst het gesprek en beantwoord een paar vragen.</p>';
    return;
  }
  sc.innerHTML = '<div style="font-size:13.6px; color:var(--text-muted); margin-bottom:6px;">Ik zet je gesprek even op een rij...</div><div class="typing-dots" style="padding:10px 0;"><span></span><span></span><span></span></div>';
  try {
    const res = await streamAnthropic({ max_tokens: 2000, system: bouwSystemPrompt(), messages: apiMessages([{ role: 'user', content: SUMMARY_PROMPT }]), stream: true }, (soFar) => {
      sc.innerHTML = '<div style="font-size:14.4px; line-height:1.7; white-space:pre-wrap;">' + formatText(soFar) + '</div>';
    });
    const tekst = res.text.trim();
    sc.innerHTML = '<div style="font-size:14.4px; line-height:1.7; white-space:pre-wrap;">' + formatText(tekst) + '</div>';
    document.getElementById('summaryTextarea').value = tekst;
    const noot = document.createElement('div');
    noot.style.cssText = 'margin-top:10px;font-size:12.8px;color:var(--text-muted);';
    noot.textContent = '⏳ Ik zet hem alvast in je Labboek...';
    sc.appendChild(noot);
    const gelukt = await opslaanInLabboek(tekst);
    noot.style.color = gelukt ? 'var(--accent2)' : '#b23b3b';
    noot.textContent = gelukt
      ? '✅ Automatisch opgeslagen bij "Oefen het gesprek" in je Labboek.'
      : '⚠️ Kon niet automatisch opslaan — kopieer hem hieronder even zelf.';
  } catch (err) {
    sc.innerHTML = '<p>' + escapeHtml(foutTekst(err)) + '</p>';
  }
});

document.getElementById('copySummaryBtn').addEventListener('click', () => {
  const ta = document.getElementById('summaryTextarea');
  const btn = document.getElementById('copySummaryBtn');
  if (!ta.value) return;
  const herstel = () => { btn.textContent = '📋 Kopieer samenvatting'; };
  const fallback = () => {
    ta.style.position = 'fixed'; ta.style.left = '0'; ta.style.top = '0'; ta.style.opacity = '0';
    ta.focus(); ta.select();
    try { document.execCommand('copy'); btn.textContent = '✅ Gekopieerd!'; } catch (e) { btn.textContent = '⚠️ Kopiëren mislukt'; }
    ta.style.position = 'absolute'; ta.style.left = '-9999px';
    setTimeout(herstel, 2000);
  };
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(ta.value).then(() => { btn.textContent = '✅ Gekopieerd!'; setTimeout(herstel, 2000); }).catch(fallback);
  } else fallback();
});

