/* =========================================================
   OPSLAAN (per deelnemer, in de browser)
   ========================================================= */
function gesprekKey() { return LS_GESPREK + (sessie ? sessie.deelnemer_id : 'onbekend'); }
function saveState() { try { localStorage.setItem(gesprekKey(), JSON.stringify(messages)); } catch (e) {} }
function loadState() { try { const r = JSON.parse(localStorage.getItem(gesprekKey()) || '[]'); return Array.isArray(r) ? r : []; } catch (e) { return []; } }

/* =========================================================
   STREAMING NAAR DAIN-CHAT
   ========================================================= */
async function streamAnthropic(body, onDelta) {
  const response = await fetch(DAIN_CHAT_ENDPOINT, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
  if (!response.ok || !response.body) {
    let errMsg = 'HTTP ' + response.status;
    try { const j = await response.json(); if (j && j.error) errMsg = (typeof j.error === 'string') ? j.error : (j.error.message || errMsg); } catch (e) {}
    const fout = new Error(errMsg); fout.status = response.status; throw fout;
  }
  const reader = response.body.getReader(); const decoder = new TextDecoder();
  let buffer = '', fullText = '', stopReason = null;
  while (true) {
    const { value, done } = await reader.read();
    if (done) break;
    buffer += decoder.decode(value, { stream: true });
    const lines = buffer.split('\n'); buffer = lines.pop();
    for (const line of lines) {
      if (!line.startsWith('data:')) continue;
      const jsonStr = line.slice(5).trim();
      if (!jsonStr || jsonStr === '[DONE]') continue;
      let evt; try { evt = JSON.parse(jsonStr); } catch (e) { continue; }
      if (evt.type === 'content_block_delta' && evt.delta && evt.delta.type === 'text_delta') { fullText += evt.delta.text; onDelta(fullText); }
      else if (evt.type === 'message_delta' && evt.delta && evt.delta.stop_reason) stopReason = evt.delta.stop_reason;
      else if (evt.type === 'error') throw new Error((evt.error && evt.error.message) || 'Onbekende streamfout');
    }
  }
  return { text: fullText, stopReason };
}

function apiMessages(extra) {
  // De API wil afwisselend user/assistant; opeenvolgende berichten van dezelfde rol voegen we samen
  const out = [];
  messages.concat(extra || []).forEach(m => {
    const last = out[out.length - 1];
    if (last && last.role === m.role) last.content += '\n\n' + m.content;
    else out.push({ role: m.role, content: m.content });
  });
  return out;
}

function foutTekst(err) {
  const msg = String((err && err.message) || ''); const status = err && err.status;
  if (status === 403 || /alleen beschikbaar/i.test(msg)) return 'Oeps, ik mag vanaf deze website niet praten. Laat het Daan even weten. 🔒';
  if (status === 429 || status === 529 || /overloaded|rate.?limit/i.test(msg)) return 'Het is even superdruk bij mij. Wacht een minuutje en probeer het opnieuw. ☕';
  if (err instanceof TypeError || /failed to fetch|networkerror|load failed/i.test(msg)) return 'Ik kon geen verbinding maken. Check je internetverbinding en probeer het opnieuw. 🙏';
  return 'Er ging iets mis aan mijn kant (' + (msg || 'onbekende fout') + '). Probeer het zo nog eens. 🙏';
}

async function callDain() {
  isSending = true; btnSend.disabled = true;
  showTyping();
  let bubble = null;
  try {
    const res = await streamAnthropic({ max_tokens: 3000, system: bouwSystemPrompt(), messages: apiMessages(), stream: true }, (soFar) => {
      const onder = isChatNearBottom();
      if (!bubble) { hideTyping(); bubble = renderMessage({ role: 'assistant', content: '', ts: nowTime() }); }
      bubble.innerHTML = formatText(soFar);
      if (onder) chatWrap.scrollTop = chatWrap.scrollHeight;
    });
    hideTyping();
    const reply = res.text.trim() || 'Sorry, daar kreeg ik even geen antwoord op. Probeer het nog eens.';
    if (!bubble) renderMessage({ role: 'assistant', content: reply, ts: nowTime() });
    else bubble.innerHTML = formatText(reply);
    messages.push({ role: 'assistant', content: reply, ts: nowTime() });
    saveState();
    logToSupabase('assistant', reply);
  } catch (err) {
    console.error(err);
    hideTyping();
    if (bubble && bubble.textContent.trim()) {
      messages.push({ role: 'assistant', content: bubble.textContent, ts: nowTime() });
    } else {
      // Mislukte beurt niet in de geschiedenis laten staan
      const laatste = messages[messages.length - 1];
      if (laatste && laatste.role === 'user') messages.pop();
      renderMessage({ role: 'assistant', content: foutTekst(err) + '\n\nJe laatste bericht is niet aangekomen, dus stuur het gerust nog een keer.', ts: nowTime() });
    }
    saveState();
  } finally {
    isSending = false; btnSend.disabled = false; msgInput.focus();
  }
}

async function sendTextMessage() {
  const text = msgInput.value.trim();
  if (!text || isSending) return;
  msgInput.value = ''; autoResize();
  const m = { role: 'user', content: text, ts: nowTime() };
  messages.push(m); renderMessage(m); saveState();
  logToSupabase('user', text);
  await callDain();
}
function autoResize() { msgInput.style.height = 'auto'; msgInput.style.height = Math.min(msgInput.scrollHeight, 110) + 'px'; }

/* =========================================================
   LOGGING (geanonimiseerd, zelfde tabel als de Dain-chat)
